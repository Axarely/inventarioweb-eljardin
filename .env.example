# Copiar a .env y completar. NUNCA versionar .env.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL 16: postgres://usuario:clave@host:puerto/base
# El usuario necesita permiso CREATEDB para que pytest cree la base de pruebas.
DATABASE_URL=postgres://inventarioweb:clave@localhost:5432/inventarioweb

# Expiración de sesión por inactividad, en segundos (RNF-02)
SESSION_COOKIE_AGE=1800

# Correo SMTP para notificaciones (RF-16). En dev.py se usa la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=InventarioWeb El Jardín <no-reply@example.com>
